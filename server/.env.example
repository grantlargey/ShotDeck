# Copy this file to server/.env and adjust if you need to.
#
#   cp server/.env.example server/.env        (macOS / Linux / Git Bash)
#   copy server\.env.example server\.env      (Windows cmd)
#
# As written, these values match the containers `npm run services:up` starts,
# so the whole app — including uploads and images — works with no AWS account.

DATABASE_URL=postgres://app:app@127.0.0.1:5432/scriptdeck
PORT=4000

# --- Media storage ----------------------------------------------------------
# AWS_ENDPOINT_URL_S3 points the API at the local S3-compatible container from
# docker-compose.yml instead of AWS. The credentials below are that container's
# fixed development credentials, not secrets.
#
# To use real AWS instead: delete AWS_ENDPOINT_URL_S3, then set the region,
# bucket and credentials to your own.
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
AWS_REGION=us-east-1
S3_BUCKET=scriptdeck-local
AWS_ACCESS_KEY_ID=scriptdeck
AWS_SECRET_ACCESS_KEY=scriptdeck-local

# --- Optional ---------------------------------------------------------------
# Enables AI screenplay formatting, and grades semantic search's candidates.
# Without it the formatter answers 503, and manual editing and PDF capture keep
# working.
# OPENAI_API_KEY=
# OPENAI_SCREENPLAY_TIMEOUT_MS=90000
#
# Enables semantic scene search with Gemini, which embeds scenes, together with
# OPENAI_API_KEY above, which grades each search's candidates. Without both the
# semantic search endpoint answers 503 and tag browsing keeps working. With the
# Gemini key, the API embeds every scene when it starts and each scene again
# whenever it is saved. Run `npm run db:migrate` before adding the key.
# GEMINI_TIMEOUT_MS bounds each request to Gemini.
# GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=30000

# Extra browser origins allowed by CORS, comma-separated. localhost and
# 127.0.0.1 on ports 5173 and 4173 are always allowed.
# ALLOWED_ORIGINS=
